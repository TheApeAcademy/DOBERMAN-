{
  "manifest_version": 2,
  "name": "D0B3RMAN",
  "version": "1.0.0",
  "description": "Detect deepfakes and verify content instantly. Right-click any image, video, or text.",
  "permissions": ["activeTab", "contextMenus", "storage", "<all_urls>"],
  "background": { "scripts": ["background.js"], "persistent": false },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }],
  "browser_action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
